-- Fog
local fogOn, fogVal = true, 0
local fogCol = Lighting.FogColor

local function updateFog()
	if not fogOn or fogVal <= 0 then
		Lighting.FogEnd = 100000
		Lighting.FogStart = 0
	else
		local p = fogVal / 100
		Lighting.FogEnd = math.clamp((1 - (p^1.5)) * 4000 + 30, 30, 5000)
		Lighting.FogStart = math.clamp(Lighting.FogEnd * 0.05, 0, Lighting.FogEnd - 5)
	end
	Lighting.FogColor = fogCol
end
updateFog()

addToggle("Névoa (Fog)", true, function(s) fogOn = s updateFog() end)
addSlider("Intensidade Névoa", 0, 100, fogVal, function(v) fogVal = v updateFog() end)

