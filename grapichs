	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local mat = obj.Material
			local name = obj.Name:lower()
			if mat == Enum.Material.Glass or name:find("glass") or name:find("vidro") then
				obj.Reflectance = s and 0.8 or 0
				obj.Transparency = s and 0.3 or 0.5
			end
		end
	end
end)

-- Outline (Em TODAS as Pessoas do Mapa)
local outlineEnabled = false
local outlineColor = Color3.fromRGB(0, 0, 0)
local outlineThickness = 0

local function applyHighlight(target)
	if not target then return end
	local h = target:FindFirstChild("GGlobalPlayerHighlight")
	if outlineEnabled then
		if not h then
			h = Instance.new("Highlight", target)
			h.Name = "GGlobalPlayerHighlight"
			h.FillTransparency = 1
		end
		h.OutlineColor = outlineColor
		h.OutlineTransparency = outlineThickness
		h.Enabled = true
	else
		if h then h:Destroy() end
	end
end

local function watchCharacter(char)
	if outlineEnabled then
		applyHighlight(char)
	end
end

local function watchPlayer(p)
	p.CharacterAdded:Connect(watchCharacter)
	if p.Character then
		watchCharacter(p.Character)
	end
end

Players.PlayerAdded:Connect(watchPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	watchPlayer(p)
end

addToggle("Outline Perfeito", false, function(s)
	outlineEnabled = s
	if not s then
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then
				local h = p.Character:FindFirstChild("GGlobalPlayerHighlight")
				if h then h:Destroy() end
			end
		end
	else
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then
				applyHighlight(p.Character)
			end
		end
	end
end)

