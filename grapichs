local order = 0
local function addToggle(txt, init, cb)
	order += 1
	local f = new("Frame", {Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(40, 40, 50), LayoutOrder = order}, scroll)
	corner(f)
	new("TextLabel", {Size = UDim2.new(0.65, 0, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1, Text = txt, TextColor3 = Color3.new(1,1,1), TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left}, f)
	local b = new("TextButton", {Size = UDim2.new(0, 50, 0, 20), Position = UDim2.new(1, -58, 0.5, -10), BackgroundColor3 = init and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(189, 195, 199), Text = init and "ON" or "OFF", TextColor3 = Color3.new(1,1,1), TextSize = 11, Font = Enum.Font.GothamBold}, f)
	corner(b, 4)
	local st = init
	b.MouseButton1Click:Connect(function()
		st = not st
		b.Text, b.BackgroundColor3 = st and "ON" or "OFF", st and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(189, 195, 199)
		cb(st)
	end)
end

local function addSlider(txt, min, max, def, cb)
	order += 1
	local f = new("Frame", {Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = Color3.fromRGB(40, 40, 50), LayoutOrder = order}, scroll)
	corner(f)
	new("TextLabel", {Size = UDim2.new(0.55, 0, 0, 18), Position = UDim2.new(0, 8, 0, 3), BackgroundTransparency = 1, Text = txt, TextColor3 = Color3.new(1,1,1), TextSize = 11, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left}, f)
	
	local rstBtn = new("TextButton", {Size = UDim2.new(0, 22, 0, 18), Position = UDim2.new(1, -125, 0, 3), BackgroundColor3 = Color3.fromRGB(60, 60, 75), Text = "↩️", TextSize = 10}, f)
	corner(rstBtn, 4)

	local box = new("TextBox", {Size = UDim2.new(0, 55, 0, 18), Position = UDim2.new(1, -63, 0, 3), BackgroundColor3 = Color3.fromRGB(55, 55, 68), Text = tostring(def), TextColor3 = Color3.new(1,1,1), TextSize = 11, Font = Enum.Font.GothamBold}, f)
	corner(box, 4)
	local bg = new("Frame", {Size = UDim2.new(1, -16, 0, 5), Position = UDim2.new(0, 8, 0, 28), BackgroundColor3 = Color3.fromRGB(60, 60, 75), BorderSizePixel = 0}, f)
	corner(bg, 4)
	local fill = new("Frame", {Size = UDim2.new(math.clamp((def - min) / (max - min), 0, 1), 0, 1, 0), BackgroundColor3 = Color3.fromRGB(52, 152, 219), BorderSizePixel = 0}, bg)
	corner(fill, 4)

	local function set(v)
		v = math.floor(math.clamp(v, min, max) * 100 + 0.5) / 100
		box.Text = tostring(v)
		fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
		cb(v)
	end
	
	rstBtn.MouseButton1Click:Connect(function() set(def) end)
	box.FocusLost:Connect(function() local n = tonumber(box.Text) if n then set(n) else box.Text = tostring(def) end end)
	local drag = false
	bg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = true end end)
	UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end end)
	UIS.InputChanged:Connect(function(i)
		if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			set(min + (max - min) * math.clamp((i.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1))
		end
	end)
end

