local motionBlur = false
addToggle("Motion Blur", false, function(s) motionBlur = s blur.Enabled = s end)
local lastRot = workspace.CurrentCamera.CFrame
RunService.RenderStepped:Connect(function()
	if motionBlur then
		local cam = workspace.CurrentCamera
		local x, y = ((cam.CFrame - cam.CFrame.Position):Inverse() * (lastRot - lastRot.Position)):ToEulerAnglesXYZ()
		blur.Size = math.clamp((math.abs(x) + math.abs(y)) * 150, 0, 30)
		lastRot = cam.CFrame
	end
end)

